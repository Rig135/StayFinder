<% layout('layouts/boilerplate') %>
    <link rel="stylesheet" href="/stylesheets/stars.css">

    <!-- Title & Location -->
    <div class="mb-4 mt-3">
        <h1 class="fw-bold mb-1" style="font-size: 2.25rem;">
            <%= listing.title %>
        </h1>
        <div class="d-flex align-items-center text-secondary fw-medium">
            <span>
                <%= listing.location %>
            </span>
        </div>
    </div>

    <!-- Photography Carousel -->
    <div class="listing-gallery mb-5 overflow-hidden position-relative"
        style="border-radius: 16px; border: 1px solid var(--border-color);">
        <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner" style="height: 500px; background-color: var(--border-color);">
                <% listing.images.forEach((img, i)=> { %>
                    <div class="carousel-item <%= i===0 ? 'active' : '' %> h-100">
                        <img src="<%= img.url %>" class="d-block w-100 h-100 object-fit-cover" alt="Property Image">
                    </div>
                    <% }) %>
            </div>
            <% if(listing.images.length> 1){ %>
                <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel"
                    data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel"
                    data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
                <% } %>
        </div>
    </div>

    <!-- Content Split -->
    <div class="row mb-5">
        <!-- Left Column: Details -->
        <div class="col-lg-8 pe-lg-5 mb-5 mb-lg-0">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-4 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1 fs-4">Hosted by <%= listing.author.username %>
                    </h3>
                    <p class="text-secondary mb-0">Superhost</p>
                </div>
                <!-- Avatar Placeholder -->
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fs-4 fw-bold shadow-sm"
                    style="width: 56px; height: 56px; background-color: var(--border-color); color: var(--text-primary) !important;">
                    <%= listing.author.username.charAt(0).toUpperCase() %>
                </div>
            </div>

            <div class="mb-4 pb-4 border-bottom">
                <h4 class="fw-bold mb-3 fs-5">About this space</h4>
                <p class="text-secondary lh-lg" style="white-space: pre-line;">
                    <%= listing.description %>
                </p>
            </div>

            <!-- Reviews Section -->
            <div>
                <h4 class="fw-bold mb-4 fs-5">Reviews</h4>
                <% if(currentUser){ %>
                    <div class="mb-4 p-4 shadow-sm"
                        style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
                        <h5 class="fw-bold mb-3 fs-6">Leave a review</h5>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="validated-form"
                            novalidate>
                            <fieldset class="starability-basic mb-3">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <div class="mb-3">
                                <textarea class="form-control" name="review[body]" id="body" rows="3"
                                    placeholder="Share your experience..." required
                                    style="border-radius: 8px; border-color: var(--border-color);"></textarea>
                                <div class="valid-feedback">Looks good!</div>
                            </div>
                            <button class="btn btn-brand px-4 py-2 fw-medium">Submit Review</button>
                        </form>
                    </div>
                    <% } %>

                        <div class="row row-cols-1 row-cols-md-2 g-4">
                            <% for(let review of listing.reviews){ %>
                                <div class="col">
                                    <div class="h-100 p-4 shadow-sm"
                                        style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold"
                                                style="width: 40px; height: 40px; background-color: var(--border-color); color: var(--text-primary) !important;">
                                                <%= review.author.username.charAt(0).toUpperCase() %>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">
                                                    <%= review.author.username %>
                                                </h6>
                                                <p class="starability-result mb-0 mt-2"
                                                    data-rating="<%= review.rating %>">
                                                    Rated: <%= review.rating %> stars
                                                </p>
                                            </div>
                                        </div>
                                        <p class="text-secondary mt-2 mb-0 fs-6 lh-lg">
                                            <%= review.body %>
                                        </p>
                                        <% if(currentUser && review.author.equals(currentUser)){ %>
                                            <form
                                                action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                                                method="post" class="mt-3">
                                                <button
                                                    class="btn btn-sm text-danger px-0 text-decoration-underline shadow-none fw-medium">Delete</button>
                                            </form>
                                            <% } %>
                                    </div>
                                </div>
                                <% } %>
                        </div>
            </div>
        </div>

        <!-- Right Column: Booking Card / Map -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="p-4 mb-4 shadow-sm"
                    style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
                    <h3 class="fw-bold mb-4">₹<%= listing.price %> <span
                                class="fs-6 text-secondary fw-normal">night</span></h3>

                    <button class="btn btn-brand w-100 py-3 mb-3 fw-bold fs-5">Reserve</button>
                    <div class="text-center text-secondary mb-3" style="font-size: 0.85rem;">You won't be charged yet
                    </div>

                    <% if(currentUser && listing.author.equals(currentUser)){ %>
                        <hr class="my-4" style="color: var(--border-color);">
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-secondary w-50 py-2"
                                href="/listings/<%= listing._id %>/edit">Edit</a>
                            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="w-50">
                                <button class="btn btn-outline-secondary text-danger w-100 py-2">Delete</button>
                            </form>
                        </div>
                        <% } %>
                </div>

                <!-- Map in sidebar for better use of space -->
                <div class="mt-4">
                    <h4 class="fw-bold mb-3 fs-5">Location</h4>
                    <div id="map" class="shadow-sm"
                        style="height: 250px; border-radius: 16px; border: 1px solid var(--border-color);"></div>
                </div>
            </div>
        </div>
    </div>

    <%- "<script>" %>
    const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
    const listing = <%- JSON.stringify(listing) %>;
    <%- "</script>" %>
    <script src="/javascripts/showPageMap.js"></script>