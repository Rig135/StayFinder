<% layout('layouts/boilerplate') %>
<div id="map" style="width: 100%; height: 500px"></div>
    <h1>All StayFinder Listings</h1>
    <div>
        <a href="/listings/new">Add Listing</a>
    </div>
  
    <% for(let stay of allStays){ %>
            <div class="card mb-3" >
                <div class="row">
                    <div class="col-md-4">
                        <img class="img-fluid" src="<%= stay.images[0].url %>" alt="">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title"><%= stay.title %></h5>
                            <p class="card-text"><%= stay.description %></p>
                            <p class="card-text">
                                <small class="text-secondary"><%= stay.location %></small>
                            </p>
                            <a href="/listings/<%= stay._id %>" class="btn btn-primary">View <%= stay.title %></a>
                        </div>
                    </div>
                </div>
            </div>
    <% } %>


    <%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const listings = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    allStays.map(listing => ({
      type: "Feature",
      geometry: listing.geometry,
      properties: { popUpMarkup: listing?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/javascripts/clusterMap.js"></script>
  
