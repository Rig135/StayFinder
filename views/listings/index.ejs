<% layout('layouts/boilerplate') %>
<div id="cluster-map" class="mb-5"></div>

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="h3 fw-bold mb-0">Explore stays</h2>
    <a href="/listings/new" class="btn btn-outline-secondary px-3">Add Listing</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    <% for(let stay of allStays){ %>
        <div class="col">
            <a href="/listings/<%= stay._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <div class="listing-img-container">
                        <% if(stay.images && stay.images.length) { %>
                            <img src="<%= stay.images[0].url %>" alt="<%= stay.title %>">
                        <% } else { %>
                            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60" alt="Default Image">
                        <% } %>
                    </div>
                    <div class="card-body p-0 listing-info">
                        <p class="listing-location text-truncate"><%= stay.location %></p>
                        <p class="listing-title text-truncate"><%= stay.title %></p>
                        <p class="listing-price">₹<%= stay.price %> <span class="fw-normal text-muted">night</span></p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>


    <%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const listings = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    allStays.map(listing => ({
      type: "Feature",
      geometry: listing.geometry,
      properties: { popUpMarkup: listing?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/javascripts/clusterMap.js"></script>
  
